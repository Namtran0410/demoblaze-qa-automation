{
  "name": "03.demoblaze-qa-automation",
  "version": "1.0.0",
  "description": "QA automation for demoblaze.com with Playwright",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Namtran0410/demoblaze-qa-automation.git"
  },
  "keywords": [],
