{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@infras/*": ["./01.src/00.infras/*"],
      "@business/*": ["./01.src/01.business/*"],
      "@fixture/*": ["./01.src/02.fixture/*"],
      "@data/*": ["./01.src/03.data/*"],
      "@utils/*": ["./01.src/04.utils/*"]
    }
  },
  "include": ["playwright.config.ts", "01.src/**/*.ts", "02.test/**/*.ts"]
}
