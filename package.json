  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Namtran0410/demoblaze-qa-automation/issues"
  },
  "homepage": "https://github.com/Namtran0410/demoblaze-qa-automation#readme",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "faker": "^6.6.6"
  }
}
